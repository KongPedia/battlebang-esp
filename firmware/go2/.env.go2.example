# Copy to firmware/go2/.env.go2 and fill local values. The real file is ignored.
# Runtime provisioning writes these values to ESP32 NVS via scripts/go2/provision.py.

GO2_SERIAL_PORT=/dev/cu.usbserial-XXXX
GO2_SERIAL_BAUD=115200

# Identity: required for provision/config payloads.
GO2_ROBOT_ID=go2_03
GO2_GROUP=go2
GO2_STAGE_ID=boss_stage_v1
GO2_LOCATION=

# Wi-Fi: required when configured=true.
GO2_WIFI_SSID=YOUR_WIFI_SSID
GO2_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
GO2_NETWORK_AUTO_START=true
GO2_NETWORK_START_DELAY_MS=0

# MQTT / Command Center broker: required when configured=true.
GO2_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
GO2_MQTT_PORT=1883
GO2_MQTT_USERNAME=
GO2_MQTT_PASSWORD=
GO2_MQTT_ROOT=battlebang
GO2_HIT_TOPIC_PREFIX=battlebang/hit

# Hit sensing/display tuning: provisioned into NVS so each robot can be tuned
# without a rebuild. Keep hardware pin/count settings in firmware/go2/hardware_profile.json.
GO2_HIT_COOLDOWN_MS=0
GO2_OFFLINE_HIT_QUEUE_CAPACITY=32
GO2_OFFLINE_HIT_QUEUE_FLUSH_INTERVAL_MS=50
GO2_LED_BRIGHTNESS=120
GO2_PIEZO_AO_THRESHOLD_RAW=200
GO2_PIEZO_AO_REARM_RAW=150
GO2_PIEZO_AO_CAPTURE_WINDOW_MS=30
GO2_PIEZO_AO_DEBUG_PERIOD_MS=100
GO2_PIEZO_AO_REARM_STABLE_MS=300

# Optional monotonic config version. Leave blank to use the current unix timestamp.
GO2_CONFIG_VERSION=

# OTA policy controls serial/MQTT/direct manifest jobs and automatic polling.
GO2_OTA_COMMAND_CENTER_CONTROLLED=true
GO2_OTA_AUTO_CHECK=false
GO2_OTA_CHANNEL=go2
GO2_OTA_DESIRED_BUILD=0
GO2_OTA_PUBLIC_MANIFEST_URL=
GO2_OTA_LOCAL_MIRROR_URL=
GO2_OTA_CHECK_INTERVAL_S=3600
GO2_OTA_APPLY_ONLY_IN_SAFE_STATE=true
