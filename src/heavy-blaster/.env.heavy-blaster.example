# Copy to src/heavy-blaster/.env.heavy-blaster (gitignored) or export these variables per command.
# Do not commit real Wi-Fi/MQTT secrets.

# USB serial port used by local provisioning/upload helpers.
HEAVY_BLASTER_SERIAL_PORT=/dev/cu.usbserial-120

# Command Center network. In the current firmware the Command Center is the MQTT broker.
HEAVY_BLASTER_WIFI_SSID=YOUR_WIFI_SSID
HEAVY_BLASTER_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
HEAVY_BLASTER_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
HEAVY_BLASTER_MQTT_PORT=1883
HEAVY_BLASTER_MQTT_ROOT=battlebang
HEAVY_BLASTER_MQTT_USERNAME=
HEAVY_BLASTER_MQTT_PASSWORD=

# Device identity/placement. Leave ID blank to keep ESP32 MAC-derived heavy-blaster id.
HEAVY_BLASTER_BLASTER_ID=
HEAVY_BLASTER_DISPLAY_NAME=Heavy Blaster
HEAVY_BLASTER_GROUP=boss_stage
HEAVY_BLASTER_LOCATION=arena
HEAVY_BLASTER_DEBUG_ALLOW_LOCAL_CONTROL=false

# Start Wi-Fi/MQTT automatically after provisioning.
HEAVY_BLASTER_NETWORK_AUTO_START=true
HEAVY_BLASTER_NETWORK_START_DELAY_MS=0

# Unlock/effect config stored in NVS.
HEAVY_BLASTER_CONFIG_VERSION=
HEAVY_BLASTER_REQUIRED_SLOTS=4
HEAVY_BLASTER_PRE_EFFECT_MS=10000
HEAVY_BLASTER_FADE_OUT_MS=4000
HEAVY_BLASTER_BLINK_BPM=40
HEAVY_BLASTER_RELAY_ON_AFTER_ALL_SLOTS=true

# Current Heavy Blaster board profile from origin/HeavyBlaster_HWsystem_test.
HEAVY_BLASTER_SLOT_COUNT=4
HEAVY_BLASTER_MATRIX_WIDTH=8
HEAVY_BLASTER_MATRIX_HEIGHT=8
HEAVY_BLASTER_MATRIX_NUM_LEDS=64
HEAVY_BLASTER_MATRIX_PINS=23,22,21,19
HEAVY_BLASTER_RELAY_PIN=26
HEAVY_BLASTER_RELAY_ACTIVE_LOW=false
HEAVY_BLASTER_RELAY_PROFILE=single_channel_active_high
HEAVY_BLASTER_LED_TYPE=WS2812B
HEAVY_BLASTER_COLOR_ORDER=GRB
HEAVY_BLASTER_LED_BRIGHTNESS=30
HEAVY_BLASTER_LED_MAX_MA=2000
HEAVY_BLASTER_ACTIVE_COLOR=#FFFF00

# OTA policy. Public manifest asset is separate from turret_fleet, hit_target, and boss_target assets.
HEAVY_BLASTER_OTA_CHANNEL=heavy-blaster
HEAVY_BLASTER_OTA_AUTO_CHECK=false
HEAVY_BLASTER_OTA_COMMAND_CENTER_CONTROLLED=true
HEAVY_BLASTER_OTA_DESIRED_BUILD=0
HEAVY_BLASTER_OTA_PUBLIC_MANIFEST_URL=https://github.com/KongPedia/battlebang-esp/releases/download/heavy-blaster-latest/heavy-blaster-manifest.json
HEAVY_BLASTER_OTA_LOCAL_MIRROR_URL=
HEAVY_BLASTER_OTA_CHECK_INTERVAL_S=300
HEAVY_BLASTER_OTA_APPLY_ONLY_IN_SAFE_STATE=true
