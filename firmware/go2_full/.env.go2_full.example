# Copy to firmware/go2_full/.env.go2_full and fill local values. The real file is ignored.
# Runtime provisioning writes identity/network/MQTT/OTA policy and per-device
# tuning values to ESP32 NVS. Relay pins, polarity, and channel count stay
# build/variant-time safety data.

GO2_FULL_SERIAL_PORT=/dev/cu.usbserial-XXXX
GO2_FULL_SERIAL_BAUD=115200
GO2_FULL_JETSON_TRANSPORT=uart2

# Identity: required for provision/config payloads.
GO2_FULL_ROBOT_ID=go2_03
GO2_FULL_BLASTER_ID=
# Relay hardware is fixed: GPIO23 flywheel + GPIO22 chain, active HIGH.
GO2_FULL_RELAY_VARIANT=relay_2ch
GO2_FULL_GROUP=go2_nixo
GO2_FULL_STAGE_ID=boss_stage_v1
GO2_FULL_LOCATION=

# Wi-Fi: required when configured=true.
GO2_FULL_WIFI_SSID=YOUR_WIFI_SSID
GO2_FULL_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
GO2_FULL_NETWORK_AUTO_START=true
GO2_FULL_NETWORK_START_DELAY_MS=0

# MQTT / Command Center broker: required when configured=true.
GO2_FULL_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
GO2_FULL_MQTT_PORT=1883
GO2_FULL_MQTT_USERNAME=
GO2_FULL_MQTT_PASSWORD=
GO2_FULL_MQTT_ROOT=battlebang
GO2_FULL_HIT_TOPIC_PREFIX=battlebang/hit
GO2_FULL_COMMAND_TOPIC_PREFIX=battlebang/nixo

# Hit sensing/display tuning: provisioned into NVS so each robot can be tuned
# without a rebuild. Keep relay pins/polarity and LED pin/count in hardware profiles.
GO2_FULL_HIT_COOLDOWN_MS=0
GO2_FULL_OFFLINE_HIT_QUEUE_CAPACITY=32
GO2_FULL_OFFLINE_HIT_QUEUE_FLUSH_INTERVAL_MS=50
GO2_FULL_LED_BRIGHTNESS=120
GO2_FULL_RING_LED_BRIGHTNESS=80
GO2_FULL_PIEZO_AO_THRESHOLD_RAW=2400
GO2_FULL_PIEZO_AO_REARM_RAW=1800
GO2_FULL_PIEZO_AO_CAPTURE_WINDOW_MS=30
GO2_FULL_PIEZO_AO_DEBUG_PERIOD_MS=1000
GO2_FULL_PIEZO_AO_REARM_STABLE_MS=30
GO2_FULL_PIEZO_CHANNEL_ENABLE_MASK=3
GO2_FULL_HP_BAR_GROUP_COUNT=28
# 0 = original RGB HP bar; 1 = new red/green-swapped HP bar (GRB on the wire).
GO2_FULL_HP_BAR_COLOR_ORDER=0
# Local ESP-owned HP/down model rendered on the HP bar LED, not the Blaster ring LED.
GO2_FULL_MAX_HITS=14
GO2_FULL_HIT_FLASH_MS=900

# Blaster fire timing/envelope tuning: provisioned into NVS. Relay pins/polarity
# still come from the selected build variant.
GO2_FULL_FIRE_DEFAULT_DURATION_MS=3000
GO2_FULL_FIRE_MIN_DURATION_MS=100
GO2_FULL_FIRE_MAX_DURATION_MS=10000
GO2_FULL_FIRE_COOLDOWN_MS=0
GO2_FULL_PREFIRE_DELAY_MS=600
GO2_FULL_RELAY_DELAY1_MS=800

# Optional monotonic config version. Leave blank to use the current unix timestamp.
GO2_FULL_CONFIG_VERSION=

# OTA policy controls serial/MQTT/direct manifest jobs and automatic polling.
GO2_FULL_OTA_COMMAND_CENTER_CONTROLLED=true
GO2_FULL_OTA_AUTO_CHECK=false
# Leave channel/url blank to let scripts/go2_full/provision.py derive them from
# GO2_FULL_RELAY_VARIANT. Explicit values override that default.
# Keep this matching the firmware you flashed. Examples:
#   esp32dev_go2_full_usb_2ch  -> go2-full-usb-2ch-latest
GO2_FULL_OTA_CHANNEL=
GO2_FULL_OTA_DESIRED_BUILD=0
GO2_FULL_OTA_PUBLIC_MANIFEST_URL=
GO2_FULL_OTA_LOCAL_MIRROR_URL=
GO2_FULL_OTA_CHECK_INTERVAL_S=3600
GO2_FULL_OTA_APPLY_ONLY_IN_SAFE_STATE=true
