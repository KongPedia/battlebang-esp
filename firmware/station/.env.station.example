# Copy to firmware/station/.env.station and fill local bench values.
# The same firmware image is uploaded to all boards; provisioning writes station_id/Wi-Fi/MQTT into NVS.

STATION_WIFI_SSID=YOUR_WIFI_SSID
STATION_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
STATION_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
STATION_MQTT_PORT=1883
STATION_MQTT_ROOT=battlebang
STATION_STAGE_ID=lit4f_260623
STATION_GROUP=boss_stage
STATION_NETWORK_AUTO_START=true
STATION_CONFIG_VERSION=

STATION_01_ID=station_01
STATION_02_ID=station_02
STATION_03_ID=station_03
STATION_04_ID=station_04
STATION_05_ID=station_05
STATION_06_ID=station_06

# Optional defaults used by scripts/station/provision.py.
STATION_STATION_ID=
STATION_DEVICE_ID=
STATION_DISPLAY_NAME=
STATION_LOCATION=
STATION_MQTT_USERNAME=
STATION_MQTT_PASSWORD=
STATION_OTA_COMMAND_CENTER_CONTROLLED=true
STATION_OTA_AUTO_CHECK=false
STATION_OTA_DESIRED_BUILD=0
STATION_OTA_PUBLIC_MANIFEST_URL=https://github.com/KongPedia/battlebang-esp/releases/download/station-latest/station-manifest.json
STATION_OTA_LOCAL_MIRROR_URL=
STATION_DEBUG_ALLOW_SIMULATE_HIT=false
STATION_SENSOR_HIT_THRESHOLD=3000
STATION_SENSOR_RELEASE_THRESHOLD=1200
STATION_SENSOR_HIT_COOLDOWN_MS=300
STATION_LED_NUM_LEDS=60
STATION_LED_BRIGHTNESS=120
STATION_LED_MAX_MA=3000
STATION_LED_WAITING_COLOR=#00FF00
STATION_LED_CAPTURED_COLOR=#FF0000
STATION_LED_HIT_FLASH_COLOR=#FFFFFF
STATION_GAMEPLAY_LOCK_AFTER_HIT=true
STATION_GAMEPLAY_AUTO_RESET_MS=0
STATION_GAMEPLAY_HEARTBEAT_INTERVAL_MS=5000
