# Copy to firmware/go2_nixo/.env.go2_nixo and fill local values. The real file is ignored.
# Runtime provisioning writes identity/network/MQTT/OTA policy and per-device
# tuning values to ESP32 NVS. Relay pins, polarity, and channel count stay
# build/variant-time safety data.

GO2_NIXO_SERIAL_PORT=/dev/cu.usbserial-XXXX
GO2_NIXO_SERIAL_BAUD=115200

# Identity: required for provision/config payloads.
GO2_NIXO_ROBOT_ID=go2_03
GO2_NIXO_NIXO_ID=
# Relay hardware variant for provisioning/OTA metadata only.
# Flash pins are selected by PlatformIO env:
#   esp32dev_go2_nixo_1ch -> GPIO23 / disabled
#   esp32dev_go2_nixo_2ch -> GPIO22 flywheel + GPIO23 chain
GO2_NIXO_RELAY_VARIANT=relay_1ch
GO2_NIXO_GROUP=go2_nixo
GO2_NIXO_STAGE_ID=boss_stage_v1
GO2_NIXO_LOCATION=

# Wi-Fi: required when configured=true.
GO2_NIXO_WIFI_SSID=YOUR_WIFI_SSID
GO2_NIXO_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
GO2_NIXO_NETWORK_AUTO_START=true
GO2_NIXO_NETWORK_START_DELAY_MS=0

# MQTT / Command Center broker: required when configured=true.
GO2_NIXO_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
GO2_NIXO_MQTT_PORT=1883
GO2_NIXO_MQTT_USERNAME=
GO2_NIXO_MQTT_PASSWORD=
GO2_NIXO_MQTT_ROOT=battlebang
GO2_NIXO_HIT_TOPIC_PREFIX=battlebang/hit
GO2_NIXO_COMMAND_TOPIC_PREFIX=battlebang/nixo

# Hit sensing/display tuning: provisioned into NVS so each robot can be tuned
# without a rebuild. Keep relay pins/polarity and LED pin/count in hardware profiles.
GO2_NIXO_HIT_COOLDOWN_MS=0
GO2_NIXO_OFFLINE_HIT_QUEUE_CAPACITY=32
GO2_NIXO_OFFLINE_HIT_QUEUE_FLUSH_INTERVAL_MS=50
GO2_NIXO_LED_BRIGHTNESS=120
GO2_NIXO_RING_LED_BRIGHTNESS=80
GO2_NIXO_PIEZO_AO_THRESHOLD_RAW=2400
GO2_NIXO_PIEZO_AO_REARM_RAW=1800
GO2_NIXO_PIEZO_AO_CAPTURE_WINDOW_MS=30
GO2_NIXO_PIEZO_AO_DEBUG_PERIOD_MS=1000
GO2_NIXO_PIEZO_AO_REARM_STABLE_MS=30
# Local ESP-owned HP/down model rendered on the HP bar LED, not the Nixo ring LED.
GO2_NIXO_MAX_HITS=14
GO2_NIXO_HIT_FLASH_MS=900

# Nixo fire timing/envelope tuning: provisioned into NVS. Relay pins/polarity
# still come from the selected build variant.
GO2_NIXO_FIRE_DEFAULT_DURATION_MS=3000
GO2_NIXO_FIRE_MIN_DURATION_MS=100
GO2_NIXO_FIRE_MAX_DURATION_MS=10000
GO2_NIXO_FIRE_COOLDOWN_MS=1500
GO2_NIXO_PREFIRE_DELAY_MS=600
GO2_NIXO_RELAY_DELAY1_MS=800

# Optional monotonic config version. Leave blank to use the current unix timestamp.
GO2_NIXO_CONFIG_VERSION=

# OTA policy controls serial/MQTT/direct manifest jobs and automatic polling.
GO2_NIXO_OTA_COMMAND_CENTER_CONTROLLED=true
GO2_NIXO_OTA_AUTO_CHECK=false
# Leave channel/url blank to let scripts/go2_nixo/provision.py derive them from
# GO2_NIXO_RELAY_VARIANT. Explicit values override that default.
# Keep this matching the firmware you flashed:
#   esp32dev_go2_nixo_1ch + relay_1ch -> go2-nixo-1ch-latest
#   esp32dev_go2_nixo_2ch + relay_2ch -> go2-nixo-2ch-latest
GO2_NIXO_OTA_CHANNEL=
GO2_NIXO_OTA_DESIRED_BUILD=0
GO2_NIXO_OTA_PUBLIC_MANIFEST_URL=
GO2_NIXO_OTA_LOCAL_MIRROR_URL=
GO2_NIXO_OTA_CHECK_INTERVAL_S=3600
GO2_NIXO_OTA_APPLY_ONLY_IN_SAFE_STATE=true
