# Copy to src/boss_target/.env.boss_target (gitignored) or export these variables per command.
# Do not commit real Wi-Fi/MQTT secrets.

# USB serial port used by local provisioning/upload helpers.
BOSS_TARGET_SERIAL_PORT=/dev/cu.usbserial-120

# Command Center network. In the current firmware the Command Center is the MQTT broker.
BOSS_TARGET_WIFI_SSID=YOUR_WIFI_SSID
BOSS_TARGET_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
BOSS_TARGET_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
BOSS_TARGET_MQTT_PORT=1883
BOSS_TARGET_MQTT_ROOT=battlebang
BOSS_TARGET_MQTT_USERNAME=
BOSS_TARGET_MQTT_PASSWORD=

# Device identity/placement. Leave IDs blank to keep ESP32 MAC-derived identity.
BOSS_TARGET_BOSS_ID=
BOSS_TARGET_TARGET_ID=
# Human-readable name for Command Center UI; boss_id remains the unique MQTT/control id.
BOSS_TARGET_DISPLAY_NAME=Boss Target
BOSS_TARGET_GROUP=demo
BOSS_TARGET_LOCATION=boss_stage
BOSS_TARGET_DEBUG_ALLOW_SIMULATE_HIT=false

# Start Wi-Fi/MQTT automatically after provisioning.
BOSS_TARGET_NETWORK_AUTO_START=true
BOSS_TARGET_NETWORK_START_DELAY_MS=0

# Runtime gameplay config stored in NVS. MVP default: 10 HP, 1 damage per correct hit.
BOSS_TARGET_CONFIG_VERSION=
BOSS_TARGET_HP_MAX=10
BOSS_TARGET_DAMAGE_PER_HIT=1
BOSS_TARGET_HP_PHASE_COUNT=3
BOSS_TARGET_TARGET_DURATION_MS=2500
BOSS_TARGET_HIT_COOLDOWN_MS=300
BOSS_TARGET_DIGITAL_ISR_DEBOUNCE_US=20000

# Current 4-target board profile. Changing pin/type/order requires a matching firmware build.
BOSS_TARGET_TARGET_COUNT=4
BOSS_TARGET_RING_NUM_LEDS=120
BOSS_TARGET_HP_BAR_NUM_LEDS=300
BOSS_TARGET_RING_PINS=23,21,18,17
BOSS_TARGET_PIEZO_DO_PINS=34,35,32,33
BOSS_TARGET_HP_BAR_PIN=12
BOSS_TARGET_LED_TYPE=WS2811
BOSS_TARGET_COLOR_ORDER=RGB
BOSS_TARGET_LED_BRIGHTNESS=255
BOSS_TARGET_LED_MAX_MA=12000
BOSS_TARGET_TARGET_ACTIVE_COLOR=#FF0000
BOSS_TARGET_TARGET_HIT_FLASH_COLOR=#FFFFFF
BOSS_TARGET_HP_PALETTE=#00FF00,#FFFF00,#FF0000
BOSS_TARGET_HP_DEAD_BLINK_MS=300

# OTA policy. Public manifest asset is separate from turret_fleet and hit_target assets.
BOSS_TARGET_OTA_CHANNEL=boss-target
BOSS_TARGET_OTA_AUTO_CHECK=false
BOSS_TARGET_OTA_COMMAND_CENTER_CONTROLLED=true
BOSS_TARGET_OTA_DESIRED_BUILD=0
BOSS_TARGET_OTA_PUBLIC_MANIFEST_URL=https://github.com/KongPedia/battlebang-esp/releases/download/boss-target-latest/boss-target-manifest.json
BOSS_TARGET_OTA_LOCAL_MIRROR_URL=
BOSS_TARGET_OTA_CHECK_INTERVAL_S=300
BOSS_TARGET_OTA_APPLY_ONLY_IN_SAFE_STATE=true
