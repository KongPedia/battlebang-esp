firmware/go2/upload_targets.toml
# Old operator-local Go2-Nixo upload maps may remain after the firmware/go2_nixo move.
src/go2_nixo/upload_targets.toml
firmware/go2_nixo/upload_targets.toml
src/turret/local_secrets.h
src/turret/upload_targets.toml
# Legacy local-only Nixo secrets may exist on operator laptops. Keep ignoring it.
src/nIxo/local_secrets.h
# Old operator-local Go2-Nixo files may remain after the firmware/go2_nixo move.
src/go2_nixo/local_secrets.h
firmware/go2_nixo/local_secrets.h
