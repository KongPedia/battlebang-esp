# Copy to src/hit_target/.env.hit_target (gitignored) or export these variables per command.
# Do not commit real Wi-Fi/MQTT secrets.

# USB serial port used by local provisioning/upload helpers.
HIT_TARGET_SERIAL_PORT=/dev/cu.usbserial-120

# Command Center network. In the current firmware the Command Center is the MQTT broker.
HIT_TARGET_WIFI_SSID=YOUR_WIFI_SSID
HIT_TARGET_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
HIT_TARGET_MQTT_HOST=COMMAND_CENTER_IP_OR_DNS
HIT_TARGET_MQTT_PORT=1883
HIT_TARGET_MQTT_ROOT=battlebang
# Optional broker auth.
HIT_TARGET_MQTT_USERNAME=
HIT_TARGET_MQTT_PASSWORD=

# Device grouping metadata. Leave target id blank to keep ESP32 MAC-derived identity.
HIT_TARGET_TARGET_ID=
HIT_TARGET_GROUP=demo
HIT_TARGET_LOCATION=wall_1
HIT_TARGET_DEBUG_ALLOW_SIMULATE_HIT=false

# Start Wi-Fi/MQTT automatically after provisioning.
HIT_TARGET_NETWORK_AUTO_START=true
HIT_TARGET_NETWORK_START_DELAY_MS=0

# Runtime gameplay config stored in NVS. Default: 3 phases x 5 hits = 15 hits.
HIT_TARGET_CONFIG_VERSION=
HIT_TARGET_HP_PHASE_COUNT=3
HIT_TARGET_HITS_PER_PHASE=5
HIT_TARGET_HP_PALETTE=#009600,#BE8200,#BE0000
HIT_TARGET_ORBIT_STEP_MS=20
HIT_TARGET_ORBIT_TAIL_LEDS=6
HIT_TARGET_HIT_FLASH_MS=50
HIT_TARGET_DAMAGE_CHIP_MS=580
HIT_TARGET_PHASE_BACKFILL_GAP_LEDS=1
HIT_TARGET_PHASE_BACKFILL_SCALE=96
HIT_TARGET_HP_HIT_PULSE_MS=180
HIT_TARGET_DEFEAT_BLACKOUT_MS=90
HIT_TARGET_DEFEAT_RAINBOW_MS=900
HIT_TARGET_DEFEAT_RAINBOW_SPINS=2

# Sensor tuning. DO sensitivity is mostly comparator potentiometer + debounce/edge count.
HIT_TARGET_PIEZO_DO_PIN=27
HIT_TARGET_PIEZO_AO_PIN=-1
HIT_TARGET_HIT_THRESHOLD=1400
HIT_TARGET_HIT_REARM_THRESHOLD=800
HIT_TARGET_HIT_COOLDOWN_MS=200
HIT_TARGET_HIT_REARM_STABLE_MS=80
HIT_TARGET_HIT_REARM_CHECK_MS=15
HIT_TARGET_DIGITAL_HIT_MIN_EDGES=2
HIT_TARGET_DIGITAL_ISR_DEBOUNCE_US=5000
HIT_TARGET_CAPTURE_WINDOW_MS=80

# OTA policy. Public manifest asset is separate from turret_fleet manifest.json.
HIT_TARGET_OTA_CHANNEL=hit-target
HIT_TARGET_OTA_AUTO_CHECK=false
HIT_TARGET_OTA_COMMAND_CENTER_CONTROLLED=true
HIT_TARGET_OTA_DESIRED_BUILD=0
HIT_TARGET_OTA_PUBLIC_MANIFEST_URL=https://github.com/KongPedia/battlebang-esp/releases/download/hit-target-latest/hit-target-manifest.json
HIT_TARGET_OTA_LOCAL_MIRROR_URL=
HIT_TARGET_OTA_CHECK_INTERVAL_S=300
HIT_TARGET_OTA_APPLY_ONLY_IN_SAFE_STATE=true
